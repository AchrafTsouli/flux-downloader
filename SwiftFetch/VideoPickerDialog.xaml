<Window x:Class="SwiftFetch.VideoPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download video"
        Width="640" Height="600" MinWidth="500" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackground1E1E1E}"
        Foreground="{DynamicResource ThemeForegroundD0D0D0}"
        FontFamily="Segoe UI">
    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" Text="Finding video…" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeForegroundFFFFFF}"/>
            <TextBlock x:Name="SourceText" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeForeground888888}"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource ThemeForegroundAAAAAA}" Text="Asking the video tools for available qualities…"/>

        <!-- One video: its qualities. -->
        <ListBox x:Name="FormatList" Grid.Row="2" Visibility="Collapsed" MouseDoubleClick="FormatList_DoubleClick"
                 Background="{DynamicResource ThemeBackground141414}" Foreground="{DynamicResource ThemeForegroundE0E0E0}" BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}"/>

        <!-- A playlist or channel: entries and one quality for all of them. -->
        <DockPanel x:Name="PlaylistPanel" Grid.Row="2" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                <Button Content="Select all" Padding="10,2" Margin="0,0,6,0" Click="SelectAll_Click" Background="{DynamicResource ThemeBackground2A2A2A}" BorderBrush="{DynamicResource ThemeBorderBrush444444}"/>
                <Button Content="Select none" Padding="10,2" Click="SelectNone_Click" Background="{DynamicResource ThemeBackground2A2A2A}" BorderBrush="{DynamicResource ThemeBorderBrush444444}"/>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForeground888888}"/>
            </DockPanel>
            <ListBox x:Name="EntryList"
                     Background="{DynamicResource ThemeBackground141414}" Foreground="{DynamicResource ThemeForegroundE0E0E0}" BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Checked="Entry_Changed" Unchecked="Entry_Changed" Foreground="{DynamicResource ThemeForegroundE0E0E0}">
                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- One video: optionally only a part of it. -->
        <Border x:Name="ClipPanel" Grid.Row="3" Margin="0,8,0,0" Padding="10,8" Visibility="Collapsed" BorderThickness="1" CornerRadius="3"
                BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}" Background="{DynamicResource ThemeBackground141414}">
            <StackPanel>
                <CheckBox x:Name="ClipCheck" Content="Download only part of the video" Margin="0" Checked="Clip_Changed" Unchecked="Clip_Changed" Foreground="{DynamicResource ThemeForegroundE0E0E0}"/>
                <StackPanel x:Name="ClipFields" Orientation="Vertical" IsEnabled="False" Margin="0,8,0,0">
                    <WrapPanel>
                        <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ClipFromBox" Width="84" Height="24" Text="0:00" ToolTip="Start time: seconds, m:ss or h:mm:ss" TextChanged="ClipTime_Changed"
                                 Background="{DynamicResource ThemeBackground1E1E1E}" Foreground="{DynamicResource ThemeForegroundE0E0E0}" BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}"/>
                        <TextBlock Text="to" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <TextBox x:Name="ClipToBox" Width="84" Height="24" ToolTip="End time: seconds, m:ss or h:mm:ss (empty = until the end)" TextChanged="ClipTime_Changed"
                                 Background="{DynamicResource ThemeBackground1E1E1E}" Foreground="{DynamicResource ThemeForegroundE0E0E0}" BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}"/>
                        <Button x:Name="PreviewButton" Content="Open at start time" Margin="12,0,0,0" Padding="10,2" Click="Preview_Click"
                                ToolTip="Opens the video in your browser at the start time, so you can check the part." Background="{DynamicResource ThemeBackground2A2A2A}" BorderBrush="{DynamicResource ThemeBorderBrush444444}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <RadioButton x:Name="FastCutRadio" GroupName="Cut" IsChecked="True" Margin="0,0,16,0" Foreground="{DynamicResource ThemeForegroundC8C8C8}"
                                     Content="Fast cut" ToolTip="Takes seconds and keeps the original quality; the part can start a second or two early (at the nearest keyframe)."/>
                        <RadioButton x:Name="ExactCutRadio" GroupName="Cut" Foreground="{DynamicResource ThemeForegroundC8C8C8}"
                                     Content="Exact to the second" ToolTip="Re-encodes the part with Windows' H.264 encoder so it starts on the very second. Slower."/>
                    </WrapPanel>
                    <TextBlock x:Name="ClipHint" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeForeground888888}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="PlaylistOptions" Grid.Row="3" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Quality" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="PresetBox" Grid.Column="1" Height="24"/>
            <CheckBox x:Name="SubfolderCheck" Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" IsChecked="True" Content="Save in a folder named after the playlist" Foreground="{DynamicResource ThemeForegroundC8C8C8}"/>
            <CheckBox x:Name="StartNowCheck" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" IsChecked="True" Content="Start downloading now (otherwise save for later)" Foreground="{DynamicResource ThemeForegroundC8C8C8}"/>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="FileButton" Content="Download as a file instead" Padding="10,3" Click="File_Click" ToolTip="Skip video detection and download the address directly." Background="{DynamicResource ThemeBackground2A2A2A}" BorderBrush="{DynamicResource ThemeBorderBrush444444}"/>
            <Button Content="Cancel" DockPanel.Dock="Right" Width="92" Height="26" IsCancel="True" Click="Cancel_Click" Background="{DynamicResource ThemeBackground2A2A2A}" BorderBrush="{DynamicResource ThemeBorderBrush444444}"/>
            <Button x:Name="DownloadButton" Content="Download" DockPanel.Dock="Right" Width="92" Height="26" Margin="0,0,8,0" IsDefault="True" IsEnabled="False" Click="Download_Click" Background="{DynamicResource ThemeBackground2A2A2A}" BorderBrush="{DynamicResource ThemeBorderBrush444444}"/>
        </DockPanel>
    </Grid>
</Window>

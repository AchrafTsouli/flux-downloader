  <Style TargetType="ContextMenu">
   <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundE4E4E4}"/><Setter Property="Background" Value="{DynamicResource ThemeBackground242424}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush454545}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="4" CornerRadius="4"><StackPanel IsItemsHost="True"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundE4E4E4}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="8,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Grid><Border x:Name="Highlight" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="CheckColumn" Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="ArrowColumn" Width="18"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="CheckMark" Text="✓" Visibility="Hidden" Foreground="{DynamicResource Accent}"/>
     <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
     <TextBlock x:Name="GestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,4,0" Foreground="{DynamicResource ThemeForegroundAAAAAA}"/>
     <TextBlock x:Name="Arrow" Grid.Column="3" Text="›" HorizontalAlignment="Right" Visibility="Hidden"/>
    </Grid></Border>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{DynamicResource ThemeBackground242424}" BorderBrush="{DynamicResource ThemeBorderBrush454545}" BorderThickness="1" Padding="4" CornerRadius="4"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></Popup>
    </Grid><ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Highlight" Property="Background" Value="#35443F"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThemeForeground858585}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="Role" Value="TopLevelHeader"><Setter Property="Padding" Value="8,2"/><Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/><Setter TargetName="CheckColumn" Property="Width" Value="0"/><Setter TargetName="ArrowColumn" Property="Width" Value="0"/><Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/></Trigger>
     <Trigger Property="Role" Value="TopLevelItem"><Setter Property="Padding" Value="8,2"/><Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/><Setter TargetName="CheckColumn" Property="Width" Value="0"/><Setter TargetName="ArrowColumn" Property="Width" Value="0"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource ThemeBackground454545}" Margin="7,4"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource ThemeForegroundDDDDDD}"/><Setter Property="Margin" Value="0,6,0,6"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource ThemeForegroundDDDDDD}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="{DynamicResource ThemeBackground252525}" Padding="12,8" Margin="0,0,2,2"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#225A44"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

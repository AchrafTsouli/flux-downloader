  <SolidColorBrush x:Key="Selection" Color="#173451"/>
  <SolidColorBrush x:Key="SelectionText" Color="#FFFFFF"/>
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#38BDF8" Offset="0"/><GradientStop Color="#818CF8" Offset="1"/></LinearGradientBrush>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Foreground" Value="{DynamicResource ThemeForegroundD0D0D0}"/><Setter Property="Background" Value="{DynamicResource ThemeBackground2A2A2A}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush3C3C3C}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#353535"/><Setter TargetName="Shell" Property="BorderBrush" Value="#4C4C4C"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#202020"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#3EC28F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>

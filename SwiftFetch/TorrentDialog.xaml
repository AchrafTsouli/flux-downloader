<Window x:Class="SwiftFetch.TorrentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download torrent"
        Width="660" Height="560" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackground1E1E1E}"
        Foreground="{DynamicResource ThemeForegroundD0D0D0}"
        FontFamily="Segoe UI">
    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" Text="Reading the torrent…" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeForegroundFFFFFF}"/>
            <TextBlock x:Name="SourceText" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeForeground888888}"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <ProgressBar x:Name="LoadingBar" DockPanel.Dock="Top" Height="4" Margin="0,0,0,6" IsIndeterminate="True" Foreground="{DynamicResource AccentGradient}" Background="{DynamicResource ThemeBackground181818}" BorderThickness="0"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource ThemeForegroundAAAAAA}"
                       Text="For a magnet link, Flux first asks people who share the torrent for its file list. This can take up to a minute."/>
        </DockPanel>

        <DockPanel x:Name="FilesPanel" Grid.Row="2" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                <Button Content="Select all" Padding="10,2" Margin="0,0,6,0" Click="SelectAll_Click" Background="{DynamicResource ThemeBackground2A2A2A}" BorderBrush="{DynamicResource ThemeBorderBrush444444}"/>
                <Button Content="Select none" Padding="10,2" Click="SelectNone_Click" Background="{DynamicResource ThemeBackground2A2A2A}" BorderBrush="{DynamicResource ThemeBorderBrush444444}"/>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForeground888888}"/>
            </DockPanel>
            <ListBox x:Name="FileList" Background="{DynamicResource ThemeBackground141414}" Foreground="{DynamicResource ThemeForegroundE0E0E0}" BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Checked="File_Changed" Unchecked="File_Changed" Foreground="{DynamicResource ThemeForegroundE0E0E0}">
                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid x:Name="OptionsPanel" Grid.Row="3" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Save in" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="FolderBox" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Background="{DynamicResource ThemeBackground141414}" Foreground="{DynamicResource ThemeForegroundE0E0E0}" BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}"/>
            <Button Grid.Column="2" Content="Browse…" Padding="10,2" Margin="6,0,0,0" Click="Browse_Click" Background="{DynamicResource ThemeBackground2A2A2A}" BorderBrush="{DynamicResource ThemeBorderBrush444444}"/>
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                <CheckBox x:Name="StartNowCheck" IsChecked="True" Content="Start now" Margin="0,0,18,0" Foreground="{DynamicResource ThemeForegroundC8C8C8}"/>
                <CheckBox x:Name="SeedCheck" Content="Share with others after finishing for" Foreground="{DynamicResource ThemeForegroundC8C8C8}" VerticalAlignment="Center"
                          ToolTip="Off by default: nothing is uploaded once your download is complete."/>
                <TextBox x:Name="SeedMinutesBox" Width="44" Height="22" Margin="6,0,4,0" Text="30" Background="{DynamicResource ThemeBackground141414}" Foreground="{DynamicResource ThemeForegroundE0E0E0}" BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}"/>
                <TextBlock Text="minutes" VerticalAlignment="Center"/>
            </WrapPanel>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <Button Content="Cancel" DockPanel.Dock="Right" Width="92" Height="26" IsCancel="True" Click="Cancel_Click" Background="{DynamicResource ThemeBackground2A2A2A}" BorderBrush="{DynamicResource ThemeBorderBrush444444}"/>
            <Button x:Name="DownloadButton" Content="Download" DockPanel.Dock="Right" Width="92" Height="26" Margin="0,0,8,0" IsDefault="True" IsEnabled="False" Click="Download_Click" Background="{DynamicResource ThemeBackground2A2A2A}" BorderBrush="{DynamicResource ThemeBorderBrush444444}"/>
        </DockPanel>
    </Grid>
</Window>

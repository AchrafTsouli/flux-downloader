<Window x:Class="SwiftFetch.DownloadInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download File Info"
        Width="600" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBackground1E1E1E}"
        Foreground="{DynamicResource ThemeForegroundD0D0D0}"
        FontFamily="Segoe UI"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,2"/><Setter Property="MinHeight" Value="26"/><Setter Property="FontSize" Value="11.5"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="5,2"/><Setter Property="MinHeight" Value="26"/><Setter Property="FontSize" Value="11.5"/></Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,4,0,4"/></Style>
        <!-- Stacked 3 Books icon (WinRAR style for Compressed) -->
        <ControlTemplate x:Key="BooksIconTemplate">
            <Canvas Width="36" Height="34">
                <!-- Red top book -->
                <Rectangle Canvas.Left="3" Canvas.Top="2" Width="30" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="#D1364E" Stroke="#8C1F31" StrokeThickness="0.8"/>
                <Rectangle Canvas.Left="4" Canvas.Top="3.5" Width="3" Height="4" Fill="#F8A5B2"/>
                <!-- Blue middle book -->
                <Rectangle Canvas.Left="3" Canvas.Top="10.5" Width="30" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="#2868B2" Stroke="#163E70" StrokeThickness="0.8"/>
                <Rectangle Canvas.Left="4" Canvas.Top="12" Width="3" Height="4" Fill="#9AC5F7"/>
                <!-- Green bottom book -->
                <Rectangle Canvas.Left="3" Canvas.Top="19" Width="30" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="#2E8B3A" Stroke="#1B5623" StrokeThickness="0.8"/>
                <Rectangle Canvas.Left="4" Canvas.Top="20.5" Width="3" Height="4" Fill="#98E2A2"/>
                <!-- Belt strap -->
                <Rectangle Canvas.Left="15" Canvas.Top="1" Width="6" Height="28" Fill="#222222" Stroke="#111111" StrokeThickness="0.5"/>
                <!-- Silver buckle -->
                <Rectangle Canvas.Left="13.5" Canvas.Top="10" Width="9" Height="8" RadiusX="1" RadiusY="1" Fill="#D8D8D8" Stroke="#555555" StrokeThickness="0.8"/>
                <Rectangle Canvas.Left="15.5" Canvas.Top="12" Width="5" Height="4" Fill="#222222"/>
            </Canvas>
        </ControlTemplate>

        <!-- Video Reel Icon -->
        <ControlTemplate x:Key="VideoIconTemplate">
            <Canvas Width="36" Height="34">
                <Rectangle Canvas.Left="4" Canvas.Top="4" Width="28" Height="28" RadiusX="2" RadiusY="2" Fill="#5A2E8A" Stroke="#3B1C5D" StrokeThickness="0.8"/>
                <Rectangle Canvas.Left="6" Canvas.Top="6" Width="4" Height="4" Fill="#FFFFFF"/>
                <Rectangle Canvas.Left="6" Canvas.Top="15" Width="4" Height="4" Fill="#FFFFFF"/>
                <Rectangle Canvas.Left="6" Canvas.Top="24" Width="4" Height="4" Fill="#FFFFFF"/>
                <Rectangle Canvas.Left="26" Canvas.Top="6" Width="4" Height="4" Fill="#FFFFFF"/>
                <Rectangle Canvas.Left="26" Canvas.Top="15" Width="4" Height="4" Fill="#FFFFFF"/>
                <Rectangle Canvas.Left="26" Canvas.Top="24" Width="4" Height="4" Fill="#FFFFFF"/>
                <Polygon Points="14,11 23,17 14,23" Fill="#FFD700"/>
            </Canvas>
        </ControlTemplate>

        <!-- Programs / Exe Icon -->
        <ControlTemplate x:Key="ProgramsIconTemplate">
            <Canvas Width="36" Height="34">
                <Rectangle Canvas.Left="4" Canvas.Top="4" Width="28" Height="28" RadiusX="2" RadiusY="2" Fill="#1D5B96" Stroke="#11375C" StrokeThickness="0.8"/>
                <Rectangle Canvas.Left="4" Canvas.Top="4" Width="28" Height="6" Fill="#2F80D3"/>
                <Polygon Points="13,15 23,22 13,29" Fill="{DynamicResource Accent}"/>
            </Canvas>
        </ControlTemplate>

        <!-- Music Icon -->
        <ControlTemplate x:Key="MusicIconTemplate">
            <Canvas Width="36" Height="34">
                <Rectangle Canvas.Left="4" Canvas.Top="4" Width="28" Height="28" RadiusX="2" RadiusY="2" Fill="#C74D28" Stroke="#7F2D14" StrokeThickness="0.8"/>
                <Path Data="M12,22 A4,3 0 1 0 16,19 L16,9 L24,7 L24,19 A4,3 0 1 0 28,16 L28,5 L14,7 L14,19 A4,3 0 1 0 12,22 Z" Fill="#FFFFFF"/>
            </Canvas>
        </ControlTemplate>

        <!-- Document Icon -->
        <ControlTemplate x:Key="DocIconTemplate">
            <Canvas Width="36" Height="34">
                <Path Data="M8,3 L22,3 L28,9 L28,31 L8,31 Z M21,3 L21,9 L28,9" Fill="#2870A0" Stroke="#164666" StrokeThickness="0.8"/>
                <Line X1="12" Y1="14" X2="24" Y2="14" Stroke="#FFFFFF" StrokeThickness="1.2"/>
                <Line X1="12" Y1="19" X2="24" Y2="19" Stroke="#FFFFFF" StrokeThickness="1.2"/>
                <Line X1="12" Y1="24" X2="20" Y2="24" Stroke="#FFFFFF" StrokeThickness="1.2"/>
            </Canvas>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Form Area -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="96"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Row 0: URL -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource ThemeForegroundC0C0C0}" FontSize="11.5"/>
            <TextBox x:Name="UrlBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="28" IsReadOnly="True"
                     Background="{DynamicResource ThemeBackground141414}" Foreground="{DynamicResource ThemeForegroundE0E0E0}" BorderBrush="{DynamicResource ThemeBorderBrush383838}" Padding="5,2" FontSize="11"/>

            <!-- Row 1: Category -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Category" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource ThemeForegroundC0C0C0}" FontSize="11.5"/>
            <DockPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                <Button Content="+" Width="26" Height="28" DockPanel.Dock="Right" Margin="6,0,0,0"
                        Click="AddCategory_Click" Background="{DynamicResource ThemeBackground262626}" BorderBrush="{DynamicResource ThemeBorderBrush3D3D3D}" ToolTip="Category manager / New category"/>
                <ComboBox x:Name="CategoryBox" Height="28" VerticalContentAlignment="Center" Padding="6,1" SelectionChanged="CategoryBox_SelectionChanged">
                    <ComboBoxItem Content="Compressed" Tag="Compressed"/>
                    <ComboBoxItem Content="Documents" Tag="Documents"/>
                    <ComboBoxItem Content="Music" Tag="Music"/>
                    <ComboBoxItem Content="Programs" Tag="Programs"/>
                    <ComboBoxItem Content="Video" Tag="Video"/>
                    <ComboBoxItem Content="General" Tag="General"/>
                </ComboBox>
            </DockPanel>

            <!-- Row 2: Save As -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Save As" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource ThemeForegroundC0C0C0}" FontSize="11.5"/>
            <DockPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                <Button Content="..." Width="28" Height="28" DockPanel.Dock="Right" Margin="6,0,0,0"
                        Click="BrowseFolder_Click" Background="{DynamicResource ThemeBackground262626}" BorderBrush="{DynamicResource ThemeBorderBrush3D3D3D}" ToolTip="Browse destination file or folder"/>
                <TextBox x:Name="SaveAsBox" Height="28"
                         Background="{DynamicResource ThemeBackground141414}" Foreground="{DynamicResource ThemeForegroundFFFFFF}" BorderBrush="{DynamicResource ThemeBorderBrush383838}" Padding="5,2" FontSize="11"/>
            </DockPanel>

            <!-- Row 3: Remember this path for "<Category>" category Box -->
            <Border Grid.Row="3" Grid.Column="1" Margin="0,2,0,2" BorderBrush="{DynamicResource ThemeBorderBrush383838}" BorderThickness="1" CornerRadius="2" Padding="8,5,8,6" Background="{DynamicResource ThemeBackground161616}">
                <StackPanel>
                    <CheckBox x:Name="RememberCategoryCheck" Margin="0,0,0,6" Content="Remember this path for &quot;Compressed&quot; category"
                              IsChecked="True" Foreground="{DynamicResource ThemeForegroundD0D0D0}" FontSize="11"
                              Checked="RememberCheck_Changed" Unchecked="RememberCheck_Changed"/>
                    <TextBox x:Name="CategoryFolderBox" Height="28" IsReadOnly="True"
                             Background="{DynamicResource ThemeBackground111111}" Foreground="{DynamicResource ThemeForeground999999}" BorderBrush="{DynamicResource ThemeBorderBrush2F2F2F}" Padding="4,2" FontSize="10.5"/>
                </StackPanel>
            </Border>

            <!-- Right Column Side Panel (Icon + File Size + Preview button) -->
            <StackPanel Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0,0,0">
                <!-- Dynamic Category / File Type Icon -->
                <Control x:Name="FileTypeIconControl" Width="36" Height="34" HorizontalAlignment="Center" Template="{StaticResource BooksIconTemplate}"/>
                
                <!-- File size display -->
                <TextBlock x:Name="FileSizeText" Text="... KB" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeForegroundE0E0E0}"
                           FontWeight="SemiBold" FontSize="11.5" Margin="0,4,0,4"/>

                <!-- Preview button -->
                <Button x:Name="PreviewButton" Content="Preview" Width="82" Height="28"
                        Click="Preview_Click" Background="{DynamicResource ThemeBackground262626}" BorderBrush="{DynamicResource ThemeBorderBrush3D3D3D}" FontSize="11"/>
            </StackPanel>

            <!-- Row 4: Description -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Description" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource ThemeForegroundC0C0C0}" FontSize="11.5"/>
            <TextBox x:Name="DescriptionBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Height="28"
                     Background="{DynamicResource ThemeBackground141414}" Foreground="{DynamicResource ThemeForegroundCCCCCC}" BorderBrush="{DynamicResource ThemeBorderBrush383838}" Padding="5,2" FontSize="11"/>
        </Grid>

        <!-- Bottom Action Buttons: Download Later / Start Download / Cancel -->
        <StackPanel Grid.Row="2" Margin="0,14,0,2">
         <StackPanel x:Name="QueuePanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10"><TextBlock Text="Queue" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="QueueBox" Width="230"/></StackPanel>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Download Later" Width="110" Height="28" Margin="0,0,12,0"
                    Click="DownloadLater_Click" Background="{DynamicResource ThemeBackground282828}" BorderBrush="{DynamicResource ThemeBorderBrush404040}" FontSize="11.5"/>
            <Button x:Name="StartButton" Content="Start Download" Width="120" Height="28" Margin="0,0,12,0"
                    IsDefault="True" Click="StartDownload_Click" Background="#1B4934" BorderBrush="#288057" Foreground="White" FontWeight="SemiBold" FontSize="11.5"/>
            <Button Content="Cancel" Width="90" Height="28"
                    IsCancel="True" Click="Cancel_Click" Background="{DynamicResource ThemeBackground282828}" BorderBrush="{DynamicResource ThemeBorderBrush404040}" FontSize="11.5"/>
         </StackPanel>
        </StackPanel>
    </Grid>
</Window>



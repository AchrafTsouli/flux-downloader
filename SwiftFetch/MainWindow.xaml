<Window x:Class="SwiftFetch.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Flux" WindowStartupLocation="CenterScreen" Width="1280" Height="800" MinWidth="1000" MinHeight="600" Background="{DynamicResource ThemeBackground1B1B1B}" Foreground="{DynamicResource ThemeForegroundD4D4D4}" FontFamily="Segoe UI" FontSize="11.5" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
 <Window.Resources>
  <Style x:Key="ToolButton" TargetType="Button">
   <Setter Property="Width" Value="68"/>
   <Setter Property="Height" Value="64"/>
   <Setter Property="Padding" Value="2,4"/>
   <Setter Property="Margin" Value="1,0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BtnBorder" Property="Background" Value="#323232"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="BtnBorder" Property="Background" Value="#202020"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="BtnBorder" Property="Opacity" Value="0.35"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="ToolLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundD0D0D0}"/>
   <Setter Property="HorizontalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,3,0,0"/>
  </Style>

  <Style x:Key="TableText" TargetType="TextBlock">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="4,0"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundD0D0D0}"/>
  </Style>
  <Style x:Key="TableCenterText" TargetType="TextBlock">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="HorizontalAlignment" Value="Center"/>
   <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundC0C0C0}"/>
  </Style>
  <Style x:Key="TableRightText" TargetType="TextBlock">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="HorizontalAlignment" Value="Right"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
   <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundD0D0D0}"/>
  </Style>

  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
   <Setter Property="Padding" Value="4,2"/>
   <Setter Property="MinHeight" Value="23"/>
  </Style>
  <Style TargetType="DataGridRow">
   <Setter Property="Background" Value="{DynamicResource ThemeBackground383838}"/>
   <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundD4D4D4}"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="TreeEntry" TargetType="TreeViewItem">
   <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundC8C8C8}"/>
   <Setter Property="FontSize" Value="11.5"/>
   <Setter Property="Padding" Value="1,0"/>
   <Setter Property="MinHeight" Value="18"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Trigger></Style.Triggers>
   <Style.Resources>
   </Style.Resources>
  </Style>


  <!-- Vector File Icons -->
  <DataTemplate x:Key="ZipIcon">
   <Canvas Width="16" Height="16">
    <Rectangle Canvas.Left="1" Canvas.Top="11" Width="14" Height="3.2" RadiusX="0.6" RadiusY="0.6" Fill="#803B99" Stroke="#5B2470" StrokeThickness="0.6"/>
    <Rectangle Canvas.Left="1" Canvas.Top="7.5" Width="14" Height="3.2" RadiusX="0.6" RadiusY="0.6" Fill="#2A9D4E" Stroke="#1D6D36" StrokeThickness="0.6"/>
    <Rectangle Canvas.Left="1" Canvas.Top="4" Width="14" Height="3.2" RadiusX="0.6" RadiusY="0.6" Fill="#2A64B4" Stroke="#1B4680" StrokeThickness="0.6"/>
    <Rectangle Canvas.Left="9" Canvas.Top="3" Width="3" Height="12" Fill="#222222"/>
    <Rectangle Canvas.Left="8.5" Canvas.Top="7.5" Width="4" Height="3.2" Stroke="#E5B338" StrokeThickness="0.8" Fill="Transparent"/>
   </Canvas>
  </DataTemplate>

  <DataTemplate x:Key="ExeIcon">
   <Canvas Width="16" Height="16">
    <Rectangle Canvas.Left="1" Canvas.Top="1" Width="14" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#224A7A" Stroke="#3F72B0" StrokeThickness="0.8"/>
    <Rectangle Canvas.Left="1" Canvas.Top="1" Width="14" Height="4" RadiusX="1" RadiusY="1" Fill="#3768A2"/>
    <Ellipse Canvas.Left="3" Canvas.Top="2.2" Width="1.5" Height="1.5" Fill="#FFFFFF"/>
    <Path Data="M4,7 L12,7 L12,13 L4,13 Z M6,9 L10,9 M6,11 L10,11" Stroke="#FFFFFF" StrokeThickness="0.8"/>
   </Canvas>
  </DataTemplate>

  <DataTemplate x:Key="PdfIcon">
   <Canvas Width="16" Height="16">
    <Path Data="M2,1 L10,1 L14,5 L14,15 L2,15 Z" Fill="#C92A2A" Stroke="#991B1B" StrokeThickness="0.6"/>
    <Path Data="M10,1 L10,5 L14,5 Z" Fill="#E05252"/>
    <Path Data="M4.5,8 C4.5,7 6.5,7 7,8.5 C7.5,10 9,11.5 11.5,12 C10,12.5 8,11.5 7.5,10 C6,11.5 4.5,11 4.5,8 Z" Stroke="#FFFFFF" StrokeThickness="0.9" Fill="Transparent"/>
   </Canvas>
  </DataTemplate>

  <DataTemplate x:Key="VideoIcon">
   <Canvas Width="16" Height="16">
    <Rectangle Canvas.Left="1" Canvas.Top="2" Width="14" Height="12" RadiusX="1.5" RadiusY="1.5" Fill="#186780" Stroke="#268CA8" StrokeThickness="0.7"/>
    <Path Data="M1,5.5 L15,5.5 M4.5,2 L2.5,5.5 M8.5,2 L6.5,5.5 M12.5,2 L10.5,5.5" Stroke="#FFFFFF" StrokeThickness="0.8"/>
    <Polygon Points="6.5,8 10.5,10 6.5,12" Fill="#FFFFFF"/>
   </Canvas>
  </DataTemplate>

  <DataTemplate x:Key="AudioIcon">
   <Canvas Width="16" Height="16">
    <Rectangle Canvas.Left="1" Canvas.Top="1" Width="14" Height="14" RadiusX="2" RadiusY="2" Fill="#1A4373" Stroke="#2E68AA" StrokeThickness="0.7"/>
    <Path Data="M6,12 A1.5,1.5 0 1,1 4.5,10.5 L6,10.5 L6,5 L11,4 L11,9.5 A1.5,1.5 0 1,1 9.5,8 L11,8 L11,4" Fill="#52B6FF"/>
   </Canvas>
  </DataTemplate>

  <DataTemplate x:Key="IsoIcon">
   <Canvas Width="16" Height="16">
    <Ellipse Canvas.Left="1" Canvas.Top="1" Width="14" Height="14" Fill="#4B5663" Stroke="#9AA6B2" StrokeThickness="0.8"/>
    <Ellipse Canvas.Left="5.5" Canvas.Top="5.5" Width="5" Height="5" Fill="#1B1B1B" Stroke="#C2C9D1" StrokeThickness="0.6"/>
   </Canvas>
  </DataTemplate>

  <DataTemplate x:Key="DocIcon">
   <Canvas Width="16" Height="16">
    <Path Data="M2,1 L10,1 L14,5 L14,15 L2,15 Z" Fill="#283A52" Stroke="#456185" StrokeThickness="0.7"/>
    <Path Data="M10,1 L10,5 L14,5 Z" Fill="#456185"/>
    <Line X1="4" Y1="7" X2="10" Y2="7" Stroke="#CAD5E2" StrokeThickness="0.8"/>
    <Line X1="4" Y1="10" X2="12" Y2="10" Stroke="#CAD5E2" StrokeThickness="0.8"/>
    <Line X1="4" Y1="13" X2="9" Y2="13" Stroke="#CAD5E2" StrokeThickness="0.8"/>
   </Canvas>
  </DataTemplate>
 </Window.Resources>

 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="24"/>
   <RowDefinition x:Name="ToolbarRow" Height="72"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="24"/>
  </Grid.RowDefinitions>

  <!-- Row 0: Menu Bar with Flux Logo -->
  <Border Background="{DynamicResource ThemeBackground202020}" BorderBrush="{DynamicResource ThemeBorderBrush2C2C2C}" BorderThickness="0,0,0,1">
   <DockPanel Margin="4,0">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0">
     <Image Source="pack://application:,,,/SwiftFetch;component/app-icon.png" Width="17" Height="17" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
     <TextBlock Text="FLUX" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
    </StackPanel>

    <Menu x:Name="MainMenu" Background="Transparent" VerticalAlignment="Center">
     <MenuItem Header="_Tasks">
      <MenuItem Header="Add new download" InputGestureText="Ctrl+L" Click="ShowAdd_Click"/>
      <MenuItem Header="Add batch download" Click="Batch_Click"/>
      <MenuItem Header="Add batch download from clipboard" Click="BatchClipboard_Click"/>
      <MenuItem Header="Run Site Grabber" Click="Grabber_Click"/>
      <Separator/><MenuItem Header="Show drop target" Click="DropTarget_Click"/>
      <Separator/><MenuItem Header="Export download links…" Click="Export_Click"/><MenuItem Header="Import download links…" Click="Import_Click"/>
      <Separator/><MenuItem Header="Exit" Click="Exit_Click"/>
     </MenuItem>
     <MenuItem Header="_File" SubmenuOpened="FileMenu_Opened">
      <MenuItem Header="Open torrent file…" Click="OpenTorrentFile_Click"/>
      <Separator/>
      <MenuItem Header="Stop download" Tag="pause" Click="Pause_Click"/>
      <MenuItem Header="Remove" Tag="remove" InputGestureText="Del" Click="Remove_Click"/>
      <MenuItem Header="Download now / Resume" Tag="resume" Click="Resume_Click"/>
      <MenuItem Header="Redownload" Tag="redownload" Click="Redownload_Click"/>
      <Separator/><MenuItem Header="Open file" Tag="open" Click="OpenFile_Click"/>
      <MenuItem Header="Show in folder" Tag="folder" Click="ShowFolder_Click"/>
      <MenuItem Header="Rename" Tag="rename" InputGestureText="F2" Click="Rename_Click"/>
     </MenuItem>
     <MenuItem Header="_Downloads">
      <MenuItem Header="Pause all" Click="PauseAll_Click"/><MenuItem Header="Stop all" Click="PauseAll_Click"/>
      <MenuItem Header="Resume all" Click="ResumeAll_Click"/>
      <Separator/><MenuItem Header="Delete all completed" Click="RemoveCompleted_Click"/>
      <Separator/><MenuItem Header="Find" InputGestureText="Ctrl+F" Click="FocusSearch_Click"/><MenuItem Header="Find next" InputGestureText="F3" Click="FindNext_Click"/>
      <Separator/><MenuItem Header="Scheduler" Click="Scheduler_Click"/><MenuItem x:Name="StartQueueMenu" Header="Start queue"/><MenuItem x:Name="StopQueueMenu" Header="Stop queue"/>
      <Separator/><MenuItem Header="Speed limiter" SubmenuOpened="SpeedLimitMenu_Opened"><MenuItem x:Name="GlobalLimitOnMenu" Header="Turn on" Click="GlobalLimitOn_Click"/><MenuItem x:Name="GlobalLimitOffMenu" Header="Turn off" Click="GlobalLimitOff_Click"/><Separator/><MenuItem Header="Settings…" Click="SpeedLimit_Click"/></MenuItem><MenuItem Header="Options" Click="Settings_Click"/>
     </MenuItem>
     <MenuItem Header="_View">
      <MenuItem x:Name="CategoriesMenu" Header="Categories panel" IsCheckable="True" IsChecked="True" Click="CloseCategories_Click"/>
      <MenuItem Header="Arrange files"><MenuItem Header="File name" Tag="FileName" Click="Arrange_Click"/><MenuItem Header="Size" Tag="Job.TotalBytes" Click="Arrange_Click"/><MenuItem Header="Status" Tag="DisplayStatus" Click="Arrange_Click"/><MenuItem Header="Date added" Tag="Job.CreatedAt" Click="Arrange_Click"/></MenuItem>
      <MenuItem x:Name="ToolbarMenu" Header="Toolbar" IsCheckable="True" IsChecked="True" Click="Toolbar_Click"/>
      <MenuItem x:Name="TrayMenu" Header="Tray icon" IsCheckable="True" Click="Tray_Click"/>
      <MenuItem Header="Customize URL list…" Click="CustomizeColumns_Click"/>
      <MenuItem x:Name="DarkMenu" Header="Dark mode" IsCheckable="True" IsChecked="True" Click="Theme_Click"/>
      <MenuItem Header="Font…" Click="Font_Click"/>
      <MenuItem Header="Language"><MenuItem Header="English" Tag="en" IsCheckable="True" IsChecked="True" Click="Language_Click"/><MenuItem Header="Français" Tag="fr" IsCheckable="True" Click="Language_Click"/></MenuItem>
      <Separator/><MenuItem Header="Download details" IsCheckable="True" IsChecked="False" Click="ToggleDetails_Click"/>
     </MenuItem>
     <MenuItem Header="_Help">
      <MenuItem Header="Help contents" Click="Help_Click"/><MenuItem Header="Tutorials" Click="Help_Click"/>
      <MenuItem Header="Scheduler and queues" Tag="Queues" Click="Help_Click"/><MenuItem Header="Grabber help" Tag="Grabber" Click="Help_Click"/>
      <Separator/><MenuItem Header="Tip of the day" Tag="Tip" Click="Help_Click"/>
      <MenuItem Header="Flux project information" Click="HomePage_Click"/><MenuItem Header="Support diagnostics" Tag="Support" Click="Help_Click"/>
      <Separator/><MenuItem Header="Check for updates" Click="CheckUpdates_Click"/>
      <Separator/><MenuItem Header="About Flux" Tag="About" Click="Help_Click"/><MenuItem Header="Tell a friend" Click="Share_Click"/>
     </MenuItem>
    </Menu>
   </DockPanel>
  </Border>

  <!-- Row 1: The Iconic IDM Toolbar -->
  <Border x:Name="MainToolbar" Grid.Row="1" Background="{DynamicResource ThemeBackground383838}" BorderBrush="{DynamicResource ThemeBorderBrush2F2F2F}" BorderThickness="0,0,0,1">
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
     <!-- 1. Add URL -->
     <Button x:Name="AddUrlButton" Style="{StaticResource ToolButton}" Click="ShowAdd_Click" ToolTip="Add URL (Ctrl+L)">
      <StackPanel HorizontalAlignment="Center">
       <Viewbox Width="34" Height="34">
        <Canvas Width="26" Height="26"><Path Data="M13,2 L13,24 M2,13 L24,13" Stroke="#83B8AF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
       </Viewbox>
       <TextBlock Style="{StaticResource ToolLabel}" Text="Add URL"/>
      </StackPanel>
     </Button>

     <!-- 2. Resume -->
     <Button Style="{StaticResource ToolButton}" x:Name="ResumeSelectionButton" Click="Resume_Click" ToolTip="Resume selected download">
      <StackPanel HorizontalAlignment="Center">
       <Viewbox Width="34" Height="34">
        <Canvas Width="26" Height="26"><Ellipse Width="24" Height="24" Canvas.Left="1" Canvas.Top="1" Stroke="#C0C0C0" StrokeThickness="1.6"/><Path Data="M13,5 V20 M7,14 L13,20 L19,14" Stroke="#C0C0C0" StrokeThickness="1.6"/></Canvas>
       </Viewbox>
       <TextBlock Style="{StaticResource ToolLabel}" Text="Resume"/>
      </StackPanel>
     </Button>

     <!-- 3. Stop -->
     <Button Style="{StaticResource ToolButton}" x:Name="PauseSelectionButton" Click="Pause_Click" ToolTip="Stop selected download">
      <StackPanel HorizontalAlignment="Center">
       <Viewbox Width="34" Height="34">
        <Canvas Width="26" Height="26"><Ellipse Width="24" Height="24" Canvas.Left="1" Canvas.Top="1" Stroke="#C0C0C0" StrokeThickness="1.6"/><Rectangle Canvas.Left="9" Canvas.Top="9" Width="8" Height="8" Stroke="#C0C0C0" StrokeThickness="1.4"/></Canvas>
       </Viewbox>
       <TextBlock Style="{StaticResource ToolLabel}" Text="Stop"/>
      </StackPanel>
     </Button>

     <!-- 4. Stop All -->
     <Button x:Name="StopAllToolButton" Style="{StaticResource ToolButton}" Click="PauseAll_Click" ToolTip="Stop all downloads">
      <StackPanel HorizontalAlignment="Center">
       <Viewbox Width="34" Height="34">
        <Canvas Width="26" Height="26"><Path Data="M7,14 V5 Q7,2 10,4 V12 V3 Q12,0 13,3 V12 V4 Q16,1 16,5 V13 V7 Q19,4 19,8 V17 Q19,24 12,24 Q8,24 6,20 L2,14 Q1,11 4,12 L7,15" Stroke="#BFBFBF" StrokeThickness="1.6" Fill="Transparent" StrokeLineJoin="Round"/></Canvas>
       </Viewbox>
       <TextBlock Style="{StaticResource ToolLabel}" Text="Stop All"/>
      </StackPanel>
     </Button>

     <!-- Separator -->
     <Border Width="1" Height="38" Background="{DynamicResource ThemeBackground363636}" Margin="4,0,4,0"/>

     <!-- 5. Delete -->
     <Button Style="{StaticResource ToolButton}" x:Name="RemoveSelectionButton" Click="Remove_Click" ToolTip="Delete selected download (Del)">
      <StackPanel HorizontalAlignment="Center">
       <Viewbox Width="34" Height="34">
        <Canvas Width="26" Height="26"><Path Data="M3,6 H23 M9,6 V2 H17 V6 M5,6 L7,24 H19 L21,6 M10,10 V20 M16,10 V20" Stroke="#DB7B83" StrokeThickness="1.6" StrokeLineJoin="Round"/></Canvas>
       </Viewbox>
       <TextBlock Style="{StaticResource ToolLabel}" Text="Delete"/>
      </StackPanel>
     </Button>

     <!-- 6. Delete Co... -->
     <Button Style="{StaticResource ToolButton}" Click="RemoveCompleted_Click" ToolTip="Delete completed downloads">
      <StackPanel HorizontalAlignment="Center">
       <Viewbox Width="34" Height="34">
        <Canvas Width="26" Height="26"><Path Data="M3,6 H23 M9,6 V2 H17 V6 M5,6 L7,24 H19 L21,6 M8,14 L12,18 L19,10" Stroke="#B285B5" StrokeThickness="1.6" StrokeLineJoin="Round"/></Canvas>
       </Viewbox>
       <TextBlock Style="{StaticResource ToolLabel}" Text="Delete Co..."/>
      </StackPanel>
     </Button>

     <!-- Separator -->
     <Border Width="1" Height="38" Background="{DynamicResource ThemeBackground363636}" Margin="4,0,4,0"/>

     <!-- 7. Options -->
     <Button Style="{StaticResource ToolButton}" Click="Settings_Click" ToolTip="Options &amp; preferences">
      <StackPanel HorizontalAlignment="Center">
       <Viewbox Width="34" Height="34">
        <Canvas Width="26" Height="26"><Polygon Points="25.00,13.00 24.77,15.34 21.78,16.64 20.90,18.28 21.49,21.49 19.67,22.98 16.64,21.78 14.85,22.32 13.00,25.00 10.66,24.77 9.36,21.78 7.72,20.90 4.51,21.49 3.02,19.67 4.22,16.64 3.68,14.85 1.00,13.00 1.23,10.66 4.22,9.36 5.10,7.72 4.51,4.51 6.33,3.02 9.36,4.22 11.15,3.68 13.00,1.00 15.34,1.23 16.64,4.22 18.28,5.10 21.49,4.51 22.98,6.33 21.78,9.36 22.32,11.15" Stroke="#A29BDC" StrokeThickness="1.4" Fill="Transparent"/><Ellipse Canvas.Left="8.5" Canvas.Top="8.5" Width="9" Height="9" Stroke="#A29BDC" StrokeThickness="1.4"/></Canvas>
       </Viewbox>
       <TextBlock Style="{StaticResource ToolLabel}" Text="Options"/>
      </StackPanel>
     </Button>

     <!-- 8. Scheduler -->
     <Button Style="{StaticResource ToolButton}" Click="Scheduler_Click" ToolTip="Scheduler">
      <StackPanel HorizontalAlignment="Center">
       <Viewbox Width="34" Height="34">
        <Canvas Width="26" Height="26"><Ellipse Canvas.Left="2" Canvas.Top="3" Width="22" Height="22" Stroke="#BA8F9B" StrokeThickness="1.6"/><Path Data="M13,7 V14 L18,10 M3,1 L1,5 M22,1 L25,5 M5,22 L3,25 M21,22 L23,25" Stroke="#BA8F9B" StrokeThickness="1.6"/></Canvas>
       </Viewbox>
       <TextBlock Style="{StaticResource ToolLabel}" Text="Scheduler"/>
      </StackPanel>
     </Button>

     <!-- 9. Start Qu... -->
     <Button x:Name="StartQueueToolButton" Style="{StaticResource ToolButton}" Click="StartQueue_Click" ToolTip="Start download queue">
      <StackPanel HorizontalAlignment="Center">
       <Viewbox Width="34" Height="34">
        <Canvas Width="26" Height="26"><Path Data="M4,20 H1 V1 H19 V5 M6,5 H24 V19 H18 M13,10 V25 M8,20 L13,25 L18,20" Stroke="#8EBBD0" StrokeThickness="1.6" Fill="Transparent"/></Canvas>
       </Viewbox>
       <TextBlock Style="{StaticResource ToolLabel}" Text="Start Qu..."/>
      </StackPanel>
     </Button>

     <!-- 10. Stop Qu... -->
     <Button x:Name="StopQueueToolButton" Style="{StaticResource ToolButton}" Click="StopQueue_Click" ToolTip="Stop download queue">
      <StackPanel HorizontalAlignment="Center">
       <Viewbox Width="34" Height="34">
        <Canvas Width="26" Height="26"><Path Data="M4,20 H1 V1 H19 V5 M6,5 H24 V24 H6 Z M10,10 H20 V20 H10 Z" Stroke="#B49CC7" StrokeThickness="1.6" Fill="Transparent"/></Canvas>
       </Viewbox>
       <TextBlock Style="{StaticResource ToolLabel}" Text="Stop Qu..."/>
      </StackPanel>
     </Button>

     <!-- Separator -->
     <Border Width="1" Height="38" Background="{DynamicResource ThemeBackground363636}" Margin="4,0,4,0"/>

     <!-- 11. Tell a Friend -->
     <Button Style="{StaticResource ToolButton}" Click="Share_Click" ToolTip="Tell a Friend">
      <StackPanel HorizontalAlignment="Center">
       <Viewbox Width="34" Height="34">
        <Canvas Width="26" Height="26"><Path Data="M2,11 H7 V25 H2 Z M7,12 L12,6 V2 Q16,0 16,5 L15,10 H22 Q25,10 24,14 L22,24 H8" Stroke="#B2A0D6" StrokeThickness="1.6" Fill="Transparent" StrokeLineJoin="Round"/></Canvas>
       </Viewbox>
       <TextBlock Style="{StaticResource ToolLabel}" Text="Tell a Friend"/>
      </StackPanel>
     </Button>
    </StackPanel>
   </ScrollViewer>
  </Border>

  <!-- Row 2: Splitter Workspace -->
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="CategoryColumn" Width="220" MinWidth="0" MaxWidth="300"/>
    <ColumnDefinition Width="3"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>

   <!-- Categories Sidebar -->
   <Border Background="{DynamicResource ThemeBackground1C1C1C}" BorderBrush="{DynamicResource ThemeBorderBrush2D2D2D}" BorderThickness="0,0,1,0">
    <DockPanel>
     <!-- Categories Header with Close 'x' Button -->
     <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeBackground212121}" BorderBrush="{DynamicResource ThemeBorderBrush2E2E2E}" BorderThickness="0,0,0,1" Height="19" Padding="4,0">
      <DockPanel VerticalAlignment="Center">
       <Button DockPanel.Dock="Right" Content="✕" Width="16" Height="16" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeForeground888888}" FontSize="9.5" Click="CloseCategories_Click" ToolTip="Hide categories"/>
       <TextBlock Text="Categories" Foreground="{DynamicResource ThemeForegroundAAAAAA}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0"/>
      </DockPanel>
     </Border>

     <!-- Category TreeView -->
     <TreeView x:Name="CategoryTree" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource TreeEntry}" SelectedItemChanged="Category_SelectedItemChanged" Margin="0,1,0,1">
      <!-- All Downloads -->
      <TreeViewItem x:Name="AllCategory" Tag="all" IsExpanded="True" IsSelected="True" ItemContainerStyle="{StaticResource TreeEntry}">
       <TreeViewItem.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <Canvas Width="15" Height="13" Margin="0,0,5,0">
          <Path Data="M1,2 L6,2 L8,4 L14,4 L14,12 L1,12 Z" Fill="#D9A738" Stroke="#B58520" StrokeThickness="0.6"/>
          <Path Data="M1,5 L14,5 L13,12 L2,12 Z" Fill="#ECC254"/>
         </Canvas>
         <TextBlock Text="All Downloads" VerticalAlignment="Center"/>
        </StackPanel>
       </TreeViewItem.Header>
       <TreeViewItem Tag="category:Compressed" ItemContainerStyle="{StaticResource TreeEntry}">
        <TreeViewItem.Header>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Canvas Width="15" Height="13" Margin="0,0,5,0">
           <Rectangle Canvas.Left="1" Canvas.Top="9" Width="13" Height="3" RadiusX="0.5" RadiusY="0.5" Fill="#803B99"/>
           <Rectangle Canvas.Left="1" Canvas.Top="5.5" Width="13" Height="3" RadiusX="0.5" RadiusY="0.5" Fill="#2A9D4E"/>
           <Rectangle Canvas.Left="1" Canvas.Top="2" Width="13" Height="3" RadiusX="0.5" RadiusY="0.5" Fill="#2A64B4"/>
           <Rectangle Canvas.Left="7" Canvas.Top="1.5" Width="2.5" Height="10.5" Fill="#222"/>
          </Canvas>
          <TextBlock Text="Compressed" VerticalAlignment="Center"/>
         </StackPanel>
        </TreeViewItem.Header>
       </TreeViewItem>
       <TreeViewItem Tag="category:Documents" ItemContainerStyle="{StaticResource TreeEntry}">
        <TreeViewItem.Header>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Canvas Width="15" Height="13" Margin="0,0,5,0">
           <Path Data="M2,1 L8,1 L12,4.5 L12,12 L2,12 Z" Fill="#284873" Stroke="#3F6DA8" StrokeThickness="0.6"/>
           <Path Data="M8,1 L8,4.5 L12,4.5 Z" Fill="#4C7EBF"/>
          </Canvas>
          <TextBlock Text="Documents" VerticalAlignment="Center"/>
         </StackPanel>
        </TreeViewItem.Header>
       </TreeViewItem>
       <TreeViewItem Tag="category:Music" ItemContainerStyle="{StaticResource TreeEntry}">
        <TreeViewItem.Header>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Canvas Width="15" Height="13" Margin="0,0,5,0">
           <Rectangle Canvas.Left="1" Canvas.Top="1" Width="13" Height="11" RadiusX="1.5" RadiusY="1.5" Fill="#1A4373"/>
           <Path Data="M5,9.5 A1,1 0 1,1 4,8.5 L5,8.5 L5,4 L9,3 L9,7.5 A1,1 0 1,1 8,6.5 L9,6.5 L9,3" Fill="#52B6FF"/>
          </Canvas>
          <TextBlock Text="Music" VerticalAlignment="Center"/>
         </StackPanel>
        </TreeViewItem.Header>
       </TreeViewItem>
       <TreeViewItem Tag="category:Programs" ItemContainerStyle="{StaticResource TreeEntry}">
        <TreeViewItem.Header>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Canvas Width="15" Height="13" Margin="0,0,5,0">
           <Rectangle Canvas.Left="1" Canvas.Top="1" Width="13" Height="11" RadiusX="1.5" RadiusY="1.5" Fill="#224A7A" Stroke="#3F72B0" StrokeThickness="0.6"/>
           <Rectangle Canvas.Left="1" Canvas.Top="1" Width="13" Height="3.2" Fill="#3768A2"/>
           <Rectangle Canvas.Left="4" Canvas.Top="5.5" Width="7" Height="4.5" Stroke="#FFFFFF" StrokeThickness="0.8"/>
          </Canvas>
          <TextBlock Text="Programs" VerticalAlignment="Center"/>
         </StackPanel>
        </TreeViewItem.Header>
       </TreeViewItem>
       <TreeViewItem Tag="category:Video" ItemContainerStyle="{StaticResource TreeEntry}">
        <TreeViewItem.Header>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Canvas Width="15" Height="13" Margin="0,0,5,0">
           <Rectangle Canvas.Left="1" Canvas.Top="1.5" Width="13" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="#186780" Stroke="#268CA8" StrokeThickness="0.6"/>
           <Polygon Points="5.5,4 9.5,6.5 5.5,9" Fill="#FFFFFF"/>
          </Canvas>
          <TextBlock Text="Video" VerticalAlignment="Center"/>
         </StackPanel>
        </TreeViewItem.Header>
       </TreeViewItem>
       <TreeViewItem Tag="category:Images" ItemContainerStyle="{StaticResource TreeEntry}">
        <TreeViewItem.Header>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Canvas Width="15" Height="13" Margin="0,0,5,0">
           <Rectangle Canvas.Left="1" Canvas.Top="1.5" Width="13" Height="10" RadiusX="1" RadiusY="1" Fill="#20583A" Stroke="#368D5F" StrokeThickness="0.6"/>
           <Ellipse Canvas.Left="3.5" Canvas.Top="3.5" Width="2" Height="2" Fill="#FFD166"/>
           <Polygon Points="2,10 5.5,6.5 7.5,8 10.5,5 12.5,10" Fill="#68D391"/>
          </Canvas>
          <TextBlock Text="Images" VerticalAlignment="Center"/>
         </StackPanel>
        </TreeViewItem.Header>
       </TreeViewItem>
       <TreeViewItem Tag="category:General" ItemContainerStyle="{StaticResource TreeEntry}">
        <TreeViewItem.Header>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Canvas Width="15" Height="13" Margin="0,0,5,0">
           <Path Data="M2,1 L8,1 L12,4.5 L12,12 L2,12 Z" Fill="#333333" Stroke="#555555" StrokeThickness="0.6"/>
          </Canvas>
          <TextBlock Text="Other" VerticalAlignment="Center"/>
         </StackPanel>
        </TreeViewItem.Header>
       </TreeViewItem>
      </TreeViewItem>

      <!-- Status Nodes -->
      <TreeViewItem Tag="unfinished" ItemContainerStyle="{StaticResource TreeEntry}">
       <TreeViewItem.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <Canvas Width="15" Height="13" Margin="0,0,5,0">
          <Path Data="M1,2 L6,2 L8,4 L14,4 L14,12 L1,12 Z" Fill="#D9A738" Stroke="#B58520" StrokeThickness="0.6"/>
          <Ellipse Canvas.Left="7.5" Canvas.Top="5.5" Width="5.5" Height="5.5" Stroke="#FFFFFF" StrokeThickness="0.9" Fill="#1B1B1B"/>
          <Path Data="M10.2,7 L10.2,8.3 L11.5,8.3" Stroke="#FFFFFF" StrokeThickness="0.8"/>
         </Canvas>
         <TextBlock Text="Unfinished" VerticalAlignment="Center"/>
        </StackPanel>
       </TreeViewItem.Header>
      </TreeViewItem>

      <TreeViewItem Tag="failed" ItemContainerStyle="{StaticResource TreeEntry}"><TreeViewItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="×" Foreground="#E88888" FontSize="16" Width="18" VerticalAlignment="Center"/><TextBlock Text="Failed" VerticalAlignment="Center"/></StackPanel></TreeViewItem.Header></TreeViewItem>
      <TreeViewItem Tag="completed" ItemContainerStyle="{StaticResource TreeEntry}">
       <TreeViewItem.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <Canvas Width="15" Height="13" Margin="0,0,5,0">
          <Path Data="M1,2 L6,2 L8,4 L14,4 L14,12 L1,12 Z" Fill="#D9A738" Stroke="#B58520" StrokeThickness="0.6"/>
          <Ellipse Canvas.Left="7.5" Canvas.Top="5.5" Width="5.5" Height="5.5" Fill="#2E9D4E"/>
          <Path Data="M8.8,8.2 L9.8,9.2 L11.8,6.8" Stroke="#FFFFFF" StrokeThickness="0.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
         </Canvas>
         <TextBlock Text="Finished" VerticalAlignment="Center"/>
        </StackPanel>
       </TreeViewItem.Header>
      </TreeViewItem>

      <TreeViewItem Tag="paused" ItemContainerStyle="{StaticResource TreeEntry}">
       <TreeViewItem.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <Canvas Width="15" Height="13" Margin="0,0,5,0">
          <Path Data="M1,2 L6,2 L8,4 L14,4 L14,12 L1,12 Z" Fill="#D9A738" Stroke="#B58520" StrokeThickness="0.6"/>
          <Rectangle Canvas.Left="8.5" Canvas.Top="6.5" Width="1.6" Height="4" Fill="#FFFFFF"/>
          <Rectangle Canvas.Left="11" Canvas.Top="6.5" Width="1.6" Height="4" Fill="#FFFFFF"/>
         </Canvas>
         <TextBlock Text="Paused" VerticalAlignment="Center"/>
        </StackPanel>
       </TreeViewItem.Header>
      </TreeViewItem>

      <TreeViewItem Tag="grabber" ItemContainerStyle="{StaticResource TreeEntry}">
       <TreeViewItem.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <Canvas Width="15" Height="13" Margin="0,0,5,0">
          <Ellipse Canvas.Left="2" Canvas.Top="1.5" Width="11" Height="10" Stroke="#3EB8C4" StrokeThickness="0.8" Fill="#123B47"/>
          <Ellipse Canvas.Left="4.5" Canvas.Top="1.5" Width="6" Height="10" Stroke="#3EB8C4" StrokeThickness="0.6"/>
          <Line X1="2" Y1="6.5" X2="13" Y2="6.5" Stroke="#3EB8C4" StrokeThickness="0.6"/>
         </Canvas>
         <TextBlock Text="Grabber projects" VerticalAlignment="Center"/>
        </StackPanel>
       </TreeViewItem.Header>
      </TreeViewItem>

      <TreeViewItem x:Name="QueuesTree" IsExpanded="True" Tag="queued" PreviewMouseLeftButtonDown="QueuesTree_MouseDown" ItemContainerStyle="{StaticResource TreeEntry}">
       <TreeViewItem.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <Canvas Width="15" Height="13" Margin="0,0,5,0">
          <Rectangle Canvas.Left="2" Canvas.Top="2" Width="11" Height="9" RadiusX="1" RadiusY="1" Fill="#37485E" Stroke="#556F91" StrokeThickness="0.6"/>
          <Line X1="4" Y1="4.5" X2="10" Y2="4.5" Stroke="#FFFFFF" StrokeThickness="0.8"/>
          <Line X1="4" Y1="7" X2="10" Y2="7" Stroke="#FFFFFF" StrokeThickness="0.8"/>
         </Canvas>
         <TextBlock Text="Queues" VerticalAlignment="Center"/>
        </StackPanel>
       </TreeViewItem.Header>
      </TreeViewItem>
     </TreeView>
    </DockPanel>
   </Border>

   <!-- GridSplitter -->
   <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="{DynamicResource ThemeBackground262626}"/>

   <!-- Right Column: Downloads DataGrid Area -->
   <Grid Grid.Column="2">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Sub-header bar for category label & search -->
    <Border Background="{DynamicResource ThemeBackground202020}" BorderBrush="{DynamicResource ThemeBorderBrush2C2C2C}" BorderThickness="0,0,0,1" Padding="6,1">
     <DockPanel>
      <Grid DockPanel.Dock="Right" Width="200" VerticalAlignment="Center">
       <TextBox x:Name="SearchBox" Height="22" Padding="6,2" FontSize="11" ToolTip="Search files, sites and categories (Ctrl+F)" TextChanged="Search_Changed"/>
       <TextBlock Text="Search downloads…" Foreground="#687991" FontSize="11" Margin="8,4,0,0" IsHitTestVisible="False">
        <TextBlock.Style>
         <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
            <Setter Property="Visibility" Value="Visible"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
      </Grid>
      <TextBlock x:Name="LibraryTitle" Text="All Downloads" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundCCCCCC}" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>

    <!-- Main DataGrid -->
    <Border Grid.Row="2" Background="{DynamicResource ThemeBackground1B1B1B}">
     <Grid>
      <DataGrid x:Name="DownloadGrid" SelectionChanged="DownloadSelection_Changed" ItemsSource="{Binding VisibleDownloads}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="All" VerticalGridLinesBrush="{DynamicResource ThemeBorderBrush2C2C2C}" HorizontalGridLinesBrush="{DynamicResource ThemeBorderBrush242424}" BorderThickness="0" RowHeight="20" ColumnHeaderHeight="23" Background="{DynamicResource ThemeBackground1B1B1B}" Foreground="{DynamicResource ThemeForegroundD4D4D4}" CanUserResizeRows="False" CanUserReorderColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" MouseDoubleClick="Download_DoubleClick" PreviewMouseRightButtonDown="Download_RightClick">
       <DataGrid.ContextMenu>
        <ContextMenu Opened="DownloadMenu_Opened" Background="{DynamicResource ThemeBackground222222}" BorderBrush="{DynamicResource ThemeBorderBrush383838}" BorderThickness="1" DataContext="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource Self}}">
         <MenuItem Header="Resume" Click="Resume_Click" IsEnabled="{Binding CanResume}"/>
         <MenuItem Header="Stop" Click="Pause_Click" IsEnabled="{Binding CanPause}"/>
         <MenuItem Header="Download progress dialog" Click="ShowProgress_Click"/>
         <Separator/>
         <MenuItem Header="Open file" Click="OpenFile_Click" IsEnabled="{Binding CanOpen}"/>
         <MenuItem Header="Show in folder" Click="ShowFolder_Click"/>
         <MenuItem Header="Copy download link" Click="CopyLink_Click"/>
         <MenuItem Header="Rename" InputGestureText="F2" Click="Rename_Click" IsEnabled="{Binding CanRename}"/>
         <MenuItem Header="Assign to queue…" Click="AssignQueue_Click" IsEnabled="{Binding CanRemove}"/><MenuItem Header="Redownload" Click="Redownload_Click" IsEnabled="{Binding CanRemove}"/><MenuItem Header="Login / session" Click="Session_Click" IsEnabled="{Binding CanEditSession}"/>
         <Separator/>
         <MenuItem Header="Inspect remote ZIP archive" Click="InspectZip_Click"/>
         <MenuItem Header="Compute SHA-256 Checksum" Click="Checksum_Click" IsEnabled="{Binding CanOpen}"/>
         <Separator/>
         <MenuItem Header="Delete" InputGestureText="Del" Click="Remove_Click" IsEnabled="{Binding CanRemove}"/>
        </ContextMenu>
       </DataGrid.ContextMenu>
       <DataGrid.Columns>
        <!-- 1. File Name (with authentic IDM icon) -->
        <DataGridTemplateColumn Header="File Name" Width="*" MinWidth="260" SortMemberPath="FileName">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <Grid Margin="3,0">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="19"/>
             <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ContentControl Content="{Binding}" VerticalAlignment="Center">
             <ContentControl.Style>
              <Style TargetType="ContentControl">
               <Setter Property="ContentTemplate" Value="{StaticResource DocIcon}"/>
               <Style.Triggers>
                <DataTrigger Binding="{Binding IconType}" Value="zip"><Setter Property="ContentTemplate" Value="{StaticResource ZipIcon}"/></DataTrigger>
                <DataTrigger Binding="{Binding IconType}" Value="exe"><Setter Property="ContentTemplate" Value="{StaticResource ExeIcon}"/></DataTrigger>
                <DataTrigger Binding="{Binding IconType}" Value="pdf"><Setter Property="ContentTemplate" Value="{StaticResource PdfIcon}"/></DataTrigger>
                <DataTrigger Binding="{Binding IconType}" Value="video"><Setter Property="ContentTemplate" Value="{StaticResource VideoIcon}"/></DataTrigger>
                <DataTrigger Binding="{Binding IconType}" Value="audio"><Setter Property="ContentTemplate" Value="{StaticResource AudioIcon}"/></DataTrigger>
                <DataTrigger Binding="{Binding IconType}" Value="iso"><Setter Property="ContentTemplate" Value="{StaticResource IsoIcon}"/></DataTrigger>
               </Style.Triggers>
              </Style>
             </ContentControl.Style>
            </ContentControl>
            <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeForegroundDCDCDC}" ToolTip="{Binding Job.Destination}"/>
           </Grid>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- 2. Q -->
        <DataGridTextColumn Header="Q" Binding="{Binding QueueText}" Width="26" CanUserSort="False" ElementStyle="{StaticResource TableCenterText}"/>

        <!-- 3. Size -->
        <DataGridTextColumn Header="Size" Binding="{Binding TotalSizeText}" Width="85" SortMemberPath="Job.TotalBytes" ElementStyle="{StaticResource TableRightText}"/>

        <!-- 4. Status -->
        <DataGridTemplateColumn Header="Status" Width="100" SortMemberPath="Status">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <TextBlock Text="{Binding DisplayStatus}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" Margin="4,0" ToolTip="{Binding StatusDetail}" TextTrimming="CharacterEllipsis"/>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- 5. Time left -->
        <DataGridTextColumn Header="Time left" Binding="{Binding EtaText}" Width="80" CanUserSort="False" ElementStyle="{StaticResource TableCenterText}"/>

        <!-- 6. Transfer rate -->
        <DataGridTextColumn Header="Transfer rate" Binding="{Binding SpeedText}" Width="95" CanUserSort="False" ElementStyle="{StaticResource TableRightText}"/>

        <!-- 7. Last Try... -->
        <DataGridTextColumn Header="Last Try..." Binding="{Binding LastTryText}" Width="105" SortMemberPath="Job.CreatedAt" ElementStyle="{StaticResource TableText}"/>

        <!-- 8. Description -->
        <DataGridTextColumn Header="Description" Binding="{Binding DescriptionText}" Width="140" SortMemberPath="SourceDomain" ElementStyle="{StaticResource TableText}"/>

        <!-- 9. Progress -->
        <DataGridTemplateColumn Header="Progress" Width="120" SortMemberPath="Percent">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <Grid Margin="6,0">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="*"/>
             <ColumnDefinition Width="34"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}" Height="5" VerticalAlignment="Center" Foreground="{DynamicResource AccentGradient}" Background="{DynamicResource ThemeBackground2B2B2B}" BorderThickness="0"/>
            <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="10" Foreground="{DynamicResource ThemeForegroundAAAAAA}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
           </Grid>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>

      <!-- Empty State -->
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
       <Canvas Width="36" Height="36" HorizontalAlignment="Center">
        <Ellipse Width="34" Height="34" Canvas.Left="1" Canvas.Top="1" Stroke="#555555" StrokeThickness="1.5"/>
        <Path Data="M18,9 L18,23 M12,17 L18,23 L24,17" Stroke="#555555" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
       </Canvas>
       <TextBlock Text="No downloads in this view" Foreground="{DynamicResource ThemeForeground999999}" FontSize="13" Margin="0,12,0,4" HorizontalAlignment="Center"/>
       <TextBlock Text="Click 'Add URL' or start a download from your browser." Foreground="{DynamicResource ThemeForeground666666}" FontSize="11" HorizontalAlignment="Center"/>
      </StackPanel>
     </Grid>
    </Border>

    <!-- Details Panel (Collapsible via View -> Download details) -->
    <Border x:Name="DetailsPanel" Grid.Row="3" Background="{DynamicResource ThemeBackground1F1F1F}" BorderBrush="{DynamicResource ThemeBorderBrush2D2D2D}" BorderThickness="0,1,0,0" Padding="10,6" Visibility="Collapsed">
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{Binding SelectedItem.FileName, ElementName=DownloadGrid, TargetNullValue=Select a download to see its details}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundDCDCDC}" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding SelectedItem.Job.Destination, ElementName=DownloadGrid}" Foreground="{DynamicResource ThemeForeground888888}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,3,10,0"/>
       <TextBlock Text="{Binding SelectedItem.StatusDetail, ElementName=DownloadGrid}" Foreground="#77AA88" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,10,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button Content="Open" Click="OpenFile_Click" Padding="10,4" IsEnabled="{Binding SelectedItem.CanOpen, ElementName=DownloadGrid, FallbackValue=False}"/>
       <Button Content="Rename" Click="Rename_Click" Padding="10,4" IsEnabled="{Binding SelectedItem.CanRename, ElementName=DownloadGrid, FallbackValue=False}"/>
       <Button Content="Login" Click="Session_Click" Padding="10,4" Margin="0" IsEnabled="{Binding SelectedItem.CanEditSession, ElementName=DownloadGrid, FallbackValue=False}"/>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
  </Grid>

  <!-- Row 3: IDM Status Bar -->
  <Border Grid.Row="3" Background="{DynamicResource ThemeBackground202020}" BorderBrush="{DynamicResource ThemeBorderBrush2C2C2C}" BorderThickness="0,1,0,0">
   <DockPanel Margin="10,0" VerticalAlignment="Center">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="Total: " Foreground="{DynamicResource ThemeForeground777777}"/>
     <TextBlock x:Name="TotalCount" Text="0" Foreground="{DynamicResource ThemeForegroundCCCCCC}" Margin="0,0,14,0"/>
     <TextBlock Text="Active: " Foreground="{DynamicResource ThemeForeground777777}"/>
     <TextBlock x:Name="ActiveCount" Text="0" Foreground="{DynamicResource ThemeForegroundCCCCCC}" Margin="0,0,14,0"/>
     <TextBlock Text="Finished: " Foreground="{DynamicResource ThemeForeground777777}"/>
     <TextBlock x:Name="CompletedCount" Text="0" Foreground="{DynamicResource ThemeForegroundCCCCCC}"/>
    </StackPanel>
    <TextBlock x:Name="MessageText" Text="Ready." Foreground="{DynamicResource ThemeForeground888888}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>



<Window x:Class="SwiftFetch.DownloadProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="0% Download" WindowStyle="None" ResizeMode="CanResize"
        Width="620" Height="520"
        MinWidth="580" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBackground1E1E1E}"
        Foreground="{DynamicResource ThemeForegroundD0D0D0}"
        FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,2"/><Setter Property="MinHeight" Value="26"/><Setter Property="FontSize" Value="11.5"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="5,2"/><Setter Property="MinHeight" Value="26"/><Setter Property="FontSize" Value="11.5"/></Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,4,0,4"/></Style>
        <!-- Tab Control Styling -->
        <Style x:Key="IdmTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundCCCCCC}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}" BorderThickness="1,1,1,0" Background="{DynamicResource ThemeBackground262626}" Margin="0,0,2,-1" CornerRadius="3,3,0,0">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ThemeBackground1E1E1E}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush4C4C4C}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundFFFFFF}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ThemeBackground2E2E2E}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBackground181818}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush383838}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="1" Background="{DynamicResource AccentGradient}">
                                    </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="{DynamicResource ThemeBackground262626}" BorderBrush="{DynamicResource ThemeBorderBrush383838}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="TrayButton" Content="→" FontSize="16" Foreground="{DynamicResource Accent}" Width="38" MinHeight="0" Height="30" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Tray_Click" ToolTip="Hide in notification area"/>
        <Button Content="—" Width="38" MinHeight="0" Height="30" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Minimize"/>
        <Button Content="□" Width="38" MinHeight="0" Height="30" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="Maximize / restore"/>
        <Button Content="×" Width="38" MinHeight="0" Height="30" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindow_Click" ToolTip="Close progress window"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" Margin="10,0,6,0" VerticalAlignment="Center"><Image Source="pack://application:,,,/SwiftFetch;component/app-icon.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="390" FontSize="11.5"/></StackPanel>
      </DockPanel>
     </Border>
    <Grid Grid.Row="1" Margin="12,12,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Section: 3 Tabs in border -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}" BorderThickness="1" CornerRadius="3" Background="{DynamicResource ThemeBackground1B1B1B}">
            <TabControl x:Name="DetailTabs" Background="Transparent" BorderThickness="0" Margin="4,4,4,4">
                
                <!-- Tab 1: Download status -->
                <TabItem Header="Download status" Style="{StaticResource IdmTabItem}">
                    <Grid Margin="10,10,10,12">
                     <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                     <TextBlock x:Name="ProgressUrlText" Grid.ColumnSpan="2" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                     <TextBlock Grid.Row="1" Text="Status" Margin="0,3"/><TextBlock x:Name="StatusVal" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource Accent}" Margin="0,3"/>
                     <TextBlock Grid.Row="2" Text="File size" Margin="0,3"/><TextBlock x:Name="FileSizeVal" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
                     <TextBlock Grid.Row="3" Text="Downloaded" Margin="0,3"/><TextBlock x:Name="DownloadedVal" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
                     <TextBlock Grid.Row="4" Text="Transfer rate" Margin="0,3"/><TextBlock x:Name="TransferRateVal" Grid.Row="4" Grid.Column="1" FontWeight="SemiBold" Margin="0,3"/>
                     <TextBlock Grid.Row="5" Text="Time left" Margin="0,3"/><TextBlock x:Name="TimeLeftVal" Grid.Row="5" Grid.Column="1" Margin="0,3"/>
                     <TextBlock Grid.Row="6" Text="Resume capability" Margin="0,3"/><TextBlock x:Name="ResumeCapabilityVal" Grid.Row="6" Grid.Column="1" Margin="0,3"/>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Speed Limiter (Screenshot 2) -->
                <TabItem Header="Speed Limiter" Style="{StaticResource IdmTabItem}">
                    <Grid Margin="10,6,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Transfer rate -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="Transfer rate" Foreground="{DynamicResource ThemeForegroundAAAAAA}" Width="130" FontSize="11" Margin="0,3"/>
                            <TextBlock x:Name="LimiterRateVal" Text="0 KB/sec" Foreground="{DynamicResource ThemeForegroundFFFFFF}" FontWeight="SemiBold" FontSize="11" Margin="0,3"/>
                        </StackPanel>

                        <!-- CheckBox Use Speed Limiter -->
                        <CheckBox x:Name="UseSpeedLimiterCheck" Grid.Row="1" Content="Use Speed Limiter"
                                  Foreground="{DynamicResource ThemeForegroundCCCCCC}" FontSize="11" VerticalAlignment="Center"
                                  Checked="SpeedLimiter_Changed" Unchecked="SpeedLimiter_Changed"/>

                        <!-- Maximum download speed input -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Maximum download speed:" Foreground="{DynamicResource ThemeForeground888888}" VerticalAlignment="Center" Margin="18,0,8,0" FontSize="11"/>
                            <TextBox x:Name="SpeedLimitValBox" Width="60" Height="28" Text="500" Margin="0,0,6,0"
                                     Background="{DynamicResource ThemeBackground141414}" Foreground="{DynamicResource ThemeForegroundFFFFFF}" BorderBrush="{DynamicResource ThemeBorderBrush383838}"
                                     TextChanged="SpeedLimitValBox_TextChanged"/>
                            <TextBlock Text="KBytes/sec" Foreground="{DynamicResource ThemeForegroundAAAAAA}" VerticalAlignment="Center" FontSize="11" Margin="0,3"/>
                        </StackPanel>

                        <!-- Remember Speed Limiter checkbox -->
                        <CheckBox x:Name="RememberLimiterCheck" Grid.Row="3" Content="Remember Speed Limiter settings for this file on stop/resume"
                                  Foreground="{DynamicResource ThemeForeground888888}" FontSize="10" VerticalAlignment="Center"/>

                        <!-- Hide tab button -->
                        <Button Grid.Row="2" Grid.Column="1" Content="Hide tab" Width="80" Height="28"
                                Click="HideTab_Click" Background="{DynamicResource ThemeBackground262626}" BorderBrush="{DynamicResource ThemeBorderBrush3D3D3D}" FontSize="11" Margin="0,3"/>
                    </Grid>
                </TabItem>

                <!-- Tab 3: Options on completion (Screenshot 3) -->
                <TabItem Header="Options on completion" Style="{StaticResource IdmTabItem}">
                    <Grid Margin="10,4,10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Save To -->
                        <TextBlock x:Name="SaveToPathBlock" Grid.Row="0" Grid.Column="0" Text="Save To: ..."
                                   Foreground="{DynamicResource ThemeForegroundCCCCCC}" FontSize="11" TextTrimming="CharacterEllipsis"/>

                        <!-- Show download complete dialog -->
                        <CheckBox x:Name="ShowCompleteDialogCheck" Grid.Row="1" Grid.Column="0"
                                  Content="Show download complete dialog" IsChecked="True"
                                  Foreground="{DynamicResource ThemeForegroundCCCCCC}" FontSize="11"
                                  Checked="CompleteOptions_Changed" Unchecked="CompleteOptions_Changed"/>

                        <!-- Hint text -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="These settings are unavailable when &quot;Show download complete dialog&quot; is turned on"
                                   Foreground="{DynamicResource ThemeForegroundAAAAAA}" FontSize="10"/>

                        <!-- Turn off computer row -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="TurnOffCheck" Content="Turn off computer when done"
                                      Foreground="{DynamicResource ThemeForeground888888}" FontSize="11" Margin="0,0,8,0" IsEnabled="False"/>
                            <ComboBox x:Name="ShutdownActionBox" SelectionChanged="CompleteOptions_Changed" Width="112" Height="28" IsEnabled="False" SelectedIndex="0">
                                <ComboBoxItem Content="Shut down"/>
                                <ComboBoxItem Content="Sleep"/>
                                <ComboBoxItem Content="Hibernate"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Exit app / Force terminate row -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ExitOnCompleteCheck" Content="Exit Flux when done"
                                      Foreground="{DynamicResource ThemeForeground888888}" FontSize="11" Margin="0,0,16,0" IsEnabled="False"/>
                            <CheckBox x:Name="ForceProcessesCheck" Content="Force processes to terminate"
                                      Foreground="{DynamicResource ThemeForeground888888}" FontSize="10" IsEnabled="False"/>
                        </StackPanel>

                        <!-- Hide tab button -->
                        <Button Grid.Row="3" Grid.Column="1" Content="Hide tab" Width="80" Height="28"
                                Click="HideTab_Click" Background="{DynamicResource ThemeBackground262626}" BorderBrush="{DynamicResource ThemeBorderBrush3D3D3D}" FontSize="11" Margin="0,3"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Middle Section: Overall Green Progress Bar -->
        <ProgressBar x:Name="OverallProgressBar" Grid.Row="1" Style="{StaticResource GreenProgressBar}"
                     Margin="0,10,0,10" Minimum="0" Maximum="100" Value="0"/>

        <!-- Action Buttons: Hide details / Pause / Cancel -->
        <DockPanel Grid.Row="2" Margin="0,0,0,10" LastChildFill="False">
            <Button x:Name="DetailsToggleButton" Content="&lt;&lt; Hide details" Width="110" Height="28"
                    DockPanel.Dock="Left" Click="DetailsToggle_Click" Background="{DynamicResource ThemeBackground262626}" BorderBrush="{DynamicResource ThemeBorderBrush3D3D3D}" FontSize="11" Margin="0,3"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="28"
                    DockPanel.Dock="Right" Margin="8,0,0,0" Click="Cancel_Click" Background="{DynamicResource ThemeBackground262626}" BorderBrush="{DynamicResource ThemeBorderBrush3D3D3D}" FontSize="11"/>
            <Button x:Name="PauseButton" Content="Pause" Width="90" Height="28"
                    DockPanel.Dock="Right" Click="Pause_Click" Background="{DynamicResource ThemeBackground262626}" BorderBrush="{DynamicResource ThemeBorderBrush3D3D3D}" FontSize="11" Margin="0,3"/>
        </DockPanel>

        <!-- Collapsible Details Section: Segments visualizer + Connections table -->
        <Grid x:Name="DetailsGrid" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Start positions and download progress by connections"
                       Foreground="{DynamicResource ThemeForegroundAAAAAA}" FontSize="11" Margin="0,0,0,4"/>

            <!-- The iconic IDM Segment visualizer bar with blue gradient & red divider lines -->
            <Border Grid.Row="1" Background="{DynamicResource ThemeBackground111111}" BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,6">
                <Canvas x:Name="SegmentCanvas" ClipToBounds="True" Height="22" SizeChanged="SegmentCanvas_SizeChanged"/>
            </Border>

            <!-- Connections DataGrid -->
            <DataGrid x:Name="ConnectionsGrid" Grid.Row="2" AutoGenerateColumns="False"
                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="{DynamicResource ThemeBackground141414}" BorderBrush="{DynamicResource ThemeBorderBrush333333}" BorderThickness="1"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N." Binding="{Binding Number}" Width="40"/>
                    <DataGridTextColumn Header="Downloaded" Binding="{Binding DownloadedText}" Width="112"/>
                    <DataGridTextColumn Header="Info" Binding="{Binding InfoText}" Width="*" MinWidth="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
    </Grid>
</Window>










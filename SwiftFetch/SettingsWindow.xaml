<Window x:Class="SwiftFetch.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Flux — Options" Width="720" Height="680" MinWidth="640" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource ThemeBackground1B1B1B}" Foreground="{DynamicResource ThemeForegroundDDDDDD}" FontFamily="Segoe UI">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock Text="Options" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
 <TabControl x:Name="Tabs" Grid.Row="1" Background="{DynamicResource ThemeBackground1B1B1B}" BorderBrush="{DynamicResource ThemeBorderBrush404040}" Padding="14"/>
 <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#E58A8A" Margin="0,8" TextWrapping="Wrap"/>
 <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Help" Click="Help_Click"/><Button Content="Cancel" IsCancel="True"/><Button Content="OK" IsDefault="True" Click="Save_Click"/></StackPanel>
 </Grid>
</Window>


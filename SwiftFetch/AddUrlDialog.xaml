<Window x:Class="SwiftFetch.AddUrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter new address to download"
        Width="520" Height="205"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackground1E1E1E}"
        Foreground="{DynamicResource ThemeForegroundD0D0D0}"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <Grid Margin="12,12,12,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Address input row -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12" VerticalAlignment="Center">
            <TextBlock Text="Address" Width="60" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundC8C8C8}" FontSize="12"/>
            <ComboBox x:Name="UrlBox" IsEditable="True" Height="26"
                      Background="{DynamicResource ThemeBackground141414}" Foreground="{DynamicResource ThemeForegroundFFFFFF}" BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}"/>
        </DockPanel>

        <!-- OK and Cancel buttons -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Top" Margin="0,0,0,0">
            <Button x:Name="OkButton" Content="OK" Width="92" Height="26" Margin="0,0,0,8"
                    IsDefault="True" Click="Ok_Click" Background="{DynamicResource ThemeBackground2A2A2A}" BorderBrush="{DynamicResource ThemeBorderBrush444444}"/>
            <Button Content="Cancel" Width="92" Height="26"
                    IsCancel="True" Click="Cancel_Click" Background="{DynamicResource ThemeBackground2A2A2A}" BorderBrush="{DynamicResource ThemeBorderBrush444444}"/>
        </StackPanel>

        <!-- Authorization GroupBox -->
        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}" BorderThickness="1" CornerRadius="2" Padding="10,8,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Checkbox in border header position -->
                <CheckBox x:Name="UseAuthCheck" Content="Use authorization" Grid.Row="0"
                          Foreground="{DynamicResource ThemeForegroundC8C8C8}" FontSize="12" Margin="0,0,0,8"
                          Checked="UseAuthCheck_Changed" Unchecked="UseAuthCheck_Changed"/>

                <!-- Login & Password fields -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Login" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForeground888888}" Margin="4,0,8,0" FontSize="11"/>
                    <TextBox x:Name="LoginBox" Grid.Column="1" Height="23" Margin="0,0,12,0"
                             IsEnabled="False" Background="{DynamicResource ThemeBackground141414}" Foreground="{DynamicResource ThemeForegroundE0E0E0}" BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}"/>

                    <TextBlock Text="Password" Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForeground888888}" Margin="0,0,8,0" FontSize="11"/>
                    <PasswordBox x:Name="PasswordBox" Grid.Column="3" Height="23"
                                 IsEnabled="False" Background="{DynamicResource ThemeBackground141414}" Foreground="{DynamicResource ThemeForegroundE0E0E0}" BorderBrush="{DynamicResource ThemeBorderBrush3A3A3A}"
                                 PasswordChar="●" Padding="6,3"/>
                </Grid>
            </Grid>
        </Border>
        <CheckBox x:Name="VideoCheck" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource ThemeForegroundC8C8C8}"
                  Content="Find video on this page (YouTube, Vimeo, X, TikTok, HLS/DASH streams and other sites)"
                  ToolTip="Lists the available qualities, or the videos in a playlist or channel, using the bundled video tools."/>
    </Grid>
</Window>

